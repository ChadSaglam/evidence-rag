{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "description": "A text span with stable identity and exact source offsets.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "text",
        "start_char",
        "end_char",
        "source"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Attribution for a document, retained on every derived chunk.",
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "language": {
          "description": "BCP 47 language tag, for example en or de-CH.",
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 retrieval date.",
          "title": "Retrieved At"
        }
      },
      "required": [
        "uri",
        "title",
        "language"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One query-chunk decision with optional completed human adjudication.",
  "properties": {
    "chunk": {
      "$ref": "#/$defs/Chunk"
    },
    "relevance": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance"
    },
    "annotator": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotator"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "chunk"
  ],
  "title": "AnnotationCandidate",
  "type": "object",
  "$id": "https://example.test/evidence-rag/schemas/annotationcandidate.schema.json"
}
