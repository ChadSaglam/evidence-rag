{
  "$defs": {
    "AnnotationCandidate": {
      "additionalProperties": false,
      "description": "One query-chunk decision with optional completed human adjudication.",
      "properties": {
        "chunk": {
          "$ref": "#/$defs/Chunk"
        },
        "relevance": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "annotator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotator"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "chunk"
      ],
      "title": "AnnotationCandidate",
      "type": "object"
    },
    "AnnotationTask": {
      "additionalProperties": false,
      "description": "One query and its rank-blind candidate decisions.",
      "properties": {
        "query": {
          "$ref": "#/$defs/Query"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/AnnotationCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "query",
        "candidates"
      ],
      "title": "AnnotationTask",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "description": "A text span with stable identity and exact source offsets.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "text",
        "start_char",
        "end_char",
        "source"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "description": "A retrieval request; language is metadata, not a routing restriction.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "top_k": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query_id",
        "text"
      ],
      "title": "Query",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Attribution for a document, retained on every derived chunk.",
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "language": {
          "description": "BCP 47 language tag, for example en or de-CH.",
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 retrieval date.",
          "title": "Retrieved At"
        }
      },
      "required": [
        "uri",
        "title",
        "language"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A corpus-bound batch of pending or completed human decisions.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "label_source": {
      "const": "human",
      "default": "human",
      "title": "Label Source",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "guidelines_version": {
      "minLength": 1,
      "title": "Guidelines Version",
      "type": "string"
    },
    "corpus_name": {
      "minLength": 1,
      "title": "Corpus Name",
      "type": "string"
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Sha256",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/AnnotationTask"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "batch_id",
    "name",
    "description",
    "split",
    "guidelines_version",
    "corpus_name",
    "corpus_sha256",
    "tasks"
  ],
  "title": "AnnotationBatch",
  "type": "object",
  "$id": "https://example.test/evidence-rag/schemas/annotationbatch.schema.json"
}
