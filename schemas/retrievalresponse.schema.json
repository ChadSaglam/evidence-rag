{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "description": "A text span with stable identity and exact source offsets.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "text",
        "start_char",
        "end_char",
        "source"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "description": "A retrieval request; language is metadata, not a routing restriction.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "top_k": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query_id",
        "text"
      ],
      "title": "Query",
      "type": "object"
    },
    "RetrievalHit": {
      "additionalProperties": false,
      "description": "A ranked chunk and the retriever-specific score that selected it.",
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "retriever": {
          "minLength": 1,
          "title": "Retriever",
          "type": "string"
        },
        "chunk": {
          "$ref": "#/$defs/Chunk"
        }
      },
      "required": [
        "rank",
        "score",
        "retriever",
        "chunk"
      ],
      "title": "RetrievalHit",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Attribution for a document, retained on every derived chunk.",
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "language": {
          "description": "BCP 47 language tag, for example en or de-CH.",
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 retrieval date.",
          "title": "Retrieved At"
        }
      },
      "required": [
        "uri",
        "title",
        "language"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Serializable search output, including enough context to audit results.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/Query"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/RetrievalHit"
      },
      "title": "Hits",
      "type": "array"
    }
  },
  "required": [
    "query",
    "hits"
  ],
  "title": "RetrievalResponse",
  "type": "object",
  "$id": "https://example.test/evidence-rag/schemas/retrievalresponse.schema.json"
}
