{
  "$defs": {
    "Query": {
      "additionalProperties": false,
      "description": "A retrieval request; language is metadata, not a routing restriction.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "top_k": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query_id",
        "text"
      ],
      "title": "Query",
      "type": "object"
    },
    "SubQuery": {
      "additionalProperties": false,
      "description": "One deterministic retrieval request derived from an original query.",
      "properties": {
        "subquery_id": {
          "minLength": 1,
          "title": "Subquery Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "subquery_id",
        "text"
      ],
      "title": "SubQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Auditable decomposition output; one subquery means no split occurred.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/Query"
    },
    "strategy": {
      "minLength": 1,
      "title": "Strategy",
      "type": "string"
    },
    "subqueries": {
      "items": {
        "$ref": "#/$defs/SubQuery"
      },
      "minItems": 1,
      "title": "Subqueries",
      "type": "array"
    }
  },
  "required": [
    "query",
    "strategy",
    "subqueries"
  ],
  "title": "QueryDecomposition",
  "type": "object",
  "$id": "https://example.test/evidence-rag/schemas/querydecomposition.schema.json"
}
