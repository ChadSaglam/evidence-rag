{
  "$defs": {
    "InjectionMatch": {
      "additionalProperties": false,
      "description": "One heuristic injection-rule match without reproducing attack text.",
      "properties": {
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        }
      },
      "required": [
        "rule_id",
        "start_char",
        "end_char"
      ],
      "title": "InjectionMatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic prompt-injection assessment for one text.",
  "properties": {
    "text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Sha256",
      "type": "string"
    },
    "flagged": {
      "title": "Flagged",
      "type": "boolean"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/InjectionMatch"
      },
      "title": "Matches",
      "type": "array"
    }
  },
  "required": [
    "text_sha256",
    "flagged",
    "matches"
  ],
  "title": "SecurityAssessment",
  "type": "object",
  "$id": "https://example.test/evidence-rag/schemas/securityassessment.schema.json"
}
